{
  "name": "touchstone",
  "description": "Touchstone 自动化测试平台 dsh 插件: Node 薄壳托管 server.py 子进程 + /touchstone 前缀反代; 浏览器半经 exports[\"./client\"] 提供侧栏入口与全屏 iframe 面板",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.bundle.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT"
}
