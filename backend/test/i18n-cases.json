    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": "01"}, "expected": "one:01"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": "+1"}, "expected": "one:+1"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": "1."}, "expected": "one:1."},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": "1.9"}, "expected": "other:1.9"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": "0x1"}, "expected": "other:0x1"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": "abc"}, "expected": "other:abc"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": ""}, "expected": "other:"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": true}, "expected": "other:true"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": false}, "expected": "other:false"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": [1]}, "expected": "other:{n}"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": {"a": 1}}, "expected": "other:{n}"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": null}, "expected": "other:{n}"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {}, "expected": "other:{n}"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": {"$native": "NaN"}}, "expected": "other:NaN"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": {"$native": "Infinity"}}, "expected": "other:Infinity"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": {"$native": "-Infinity"}}, "expected": "other:-Infinity"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": 0}, "expected": "other:0"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": 2}, "expected": "other:2"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": "2"}, "expected": "other:2"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": -1}, "expected": "other:-1"},

    {"kind": "normalize", "input": "zh", "expected": "zh"},
    {"kind": "normalize", "input": "ZH", "expected": "zh"},
    {"kind": "normalize", "input": "zh-CN", "expected": "zh"},
    {"kind": "normalize", "input": "zh_CN", "expected": "zh"},
