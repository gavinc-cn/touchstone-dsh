{
  "doc": [
    "Node（backend/test/i18n.test.mjs）与 Python（tests/test_i18n.py）共享的 i18n 用例表。",
    "两端必须逐条读取同一份文件并断言同一输出，任何一端语义分叉都会在同一行失败。",
    "kind=t：{ns,key,lang?,vars?,varsNative?,expected}；lang 缺省时调用 t(ns,key)（默认 zh）。",
    "kind=normalize：{input,expected}；kind=resolve：{headers,query,userPref,expected}。",
    "kind=dict：把 raw 原样写入临时文件后 loadDict/load_dict，再断言 t(ns,key,lang,...)；",
    "  用于验证非法词典根节点/NaN/Infinity 在两端都整份降级为中文。",
    "特殊值标记（JSON 无法表达 NaN/undefined/抛错对象）：",
    "  {\"$native\":\"undefined\"}          => Node undefined / Python None",
    "  {\"$native\":\"NaN\"}                => NaN / float('nan')",
    "  {\"$native\":\"Infinity\"}           => Infinity / float('inf')",
    "  {\"$native\":\"-Infinity\"}          => -Infinity / float('-inf')",
    "  {\"$native\":\"throwingToString\"}   => toString/valueOf 抛错的对象 / __str__、__float__ 抛错的对象",
    "  {\"$native\":\"throwingProxy\"}      => get 陷阱抛错的 Proxy / 等价的 __str__ 抛错对象（Python 无 Proxy）",
    "  case.varsNative=\"throwingProxy\"    => Node 传 new Proxy({v:1},{get(){throw}})；Python 传 {v: 抛错对象}",
    "  两端对变量逐个 try/catch，任何异常都只保留 {占位符}，绝不让 t() 抛错。"
  ],
  "fixture": {
    "web": {
      "保存": "Save",
      "共 {n} 张卡片": {"one": "{n} card", "other": "{n} cards"},
      "复数 {n}": {"one": "one:{n}", "other": "other:{n}"},
      "你好 {name}": "Hello {name}",
      "值 {v}": "value {v}",
      "代理 {v}": "proxy {v}",
      "仅有单数": {"one": "{n} item"},
      "非法词条": 42
    },
    "api": {
      "项目不存在": "project not found",
      "删除失败: {name}": "Delete failed: {name}"
    },
    "prompt": {}
  },
  "cases": [
    {"kind": "t", "ns": "web", "key": "保存", "lang": "zh", "vars": {}, "expected": "保存"},
    {"kind": "t", "ns": "web", "key": "保存", "vars": {}, "expected": "保存", "doc": "KB-17：省略 lang 走函数默认参数，输出必须与显式 zh 逐字节相同"},
    {"kind": "t", "ns": "web", "key": "共 {n} 张卡片", "lang": "zh", "vars": {"n": 3}, "expected": "共 3 张卡片"},
    {"kind": "t", "ns": "web", "key": "保存", "lang": "en", "vars": {}, "expected": "Save"},
    {"kind": "t", "ns": "web", "key": "保存", "lang": "EN", "vars": {}, "expected": "Save"},
    {"kind": "t", "ns": "web", "key": "保存", "lang": "en-US", "vars": {}, "expected": "Save"},
    {"kind": "t", "ns": "web", "key": "保存", "lang": "zh-CN", "vars": {}, "expected": "保存"},
    {"kind": "t", "ns": "web", "key": "保存", "lang": "fr-FR", "vars": {}, "expected": "保存"},
    {"kind": "t", "ns": "web", "key": "保存", "lang": null, "vars": {}, "expected": "保存"},
    {"kind": "t", "ns": "web", "key": "你好 {name}", "lang": "en", "vars": {"name": "Ada"}, "expected": "Hello Ada"},
    {"kind": "t", "ns": "web", "key": "你好 {name}", "lang": "en", "vars": {}, "expected": "Hello {name}"},
    {"kind": "t", "ns": "web", "key": "你好 {name}", "lang": "en", "vars": {"name": null}, "expected": "Hello {name}"},
    {"kind": "t", "ns": "web", "key": "共 {n} 张卡片", "lang": "en", "vars": {"n": 1}, "expected": "1 card"},
    {"kind": "t", "ns": "web", "key": "共 {n} 张卡片", "lang": "EN", "vars": {"n": 1}, "expected": "1 card"},
    {"kind": "t", "ns": "web", "key": "共 {n} 张卡片", "lang": "en", "vars": {"n": 0}, "expected": "0 cards"},
    {"kind": "t", "ns": "web", "key": "共 {n} 张卡片", "lang": "en", "vars": {"n": 2}, "expected": "2 cards"},
    {"kind": "t", "ns": "web", "key": "共 {n} 张卡片", "lang": "en", "vars": {"n": "1"}, "expected": "1 card"},
    {"kind": "t", "ns": "web", "key": "共 {n} 张卡片", "lang": "en", "vars": {"n": "2"}, "expected": "2 cards"},
    {"kind": "t", "ns": "web", "key": "共 {n} 张卡片", "lang": "en", "vars": {}, "expected": "{n} cards"},
    {"kind": "t", "ns": "web", "key": "仅有单数", "lang": "en", "vars": {"n": 1}, "expected": "1 item"},
    {"kind": "t", "ns": "web", "key": "仅有单数", "lang": "en", "vars": {"n": 2}, "expected": "2 item"},
    {"kind": "t", "ns": "web", "key": "未收录", "lang": "en", "vars": {"n": 1}, "expected": "未收录"},
    {"kind": "t", "ns": "web", "key": "缺失 {x}", "lang": "en", "vars": {"x": "y"}, "expected": "缺失 y"},
    {"kind": "t", "ns": "web", "key": "非法词条", "lang": "en", "vars": {}, "expected": "非法词条"},
    {"kind": "t", "ns": "nope", "key": "保存", "lang": "en", "vars": {}, "expected": "保存"},
    {"kind": "t", "ns": "prompt", "key": "任意", "lang": "en", "vars": {}, "expected": "任意"},
    {"kind": "t", "ns": "api", "key": "项目不存在", "lang": "en", "vars": {}, "expected": "project not found"},
    {"kind": "t", "ns": "api", "key": "删除失败: {name}", "lang": "en", "vars": {"name": "x"}, "expected": "Delete failed: x"},
    {"kind": "t", "ns": "web", "key": "保留 {bad-name} 与 {ok}", "lang": "zh", "vars": {"ok": "X"}, "expected": "保留 {bad-name} 与 X"},
    {"kind": "t", "ns": "web", "key": "", "lang": "zh", "vars": {}, "expected": ""},
    {"kind": "t", "ns": "web", "key": "", "lang": "en", "vars": {}, "expected": ""},

    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "zh", "vars": {}, "expected": "值 {v}"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "zh", "vars": {"v": true}, "expected": "值 true"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "zh", "vars": {"v": false}, "expected": "值 false"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": true}, "expected": "value true"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": false}, "expected": "value false"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "zh", "vars": {"v": 3}, "expected": "值 3"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": 3}, "expected": "value 3"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": 1.0}, "expected": "value 1"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": 1.5}, "expected": "value 1.5"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "zh", "vars": {"v": 0.1}, "expected": "值 0.1"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": -2.25}, "expected": "value -2.25"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": -0.0}, "expected": "value 0"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": 123456789.5}, "expected": "value 123456789.5"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": 0.000001}, "expected": "value 0.000001"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": 0.000001234}, "expected": "value 0.000001234"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": 1e-7}, "expected": "value 1e-7"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": 1e20}, "expected": "value 100000000000000000000"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": 1e21}, "expected": "value 1e+21"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": {"$native": "NaN"}}, "expected": "value NaN"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "zh", "vars": {"v": {"$native": "NaN"}}, "expected": "值 NaN"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": {"$native": "Infinity"}}, "expected": "value Infinity"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": {"$native": "-Infinity"}}, "expected": "value -Infinity"},

    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": {"$native": "undefined"}}, "expected": "value {v}"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": {"a": 1}}, "expected": "value {v}"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "zh", "vars": {"v": [1, 2]}, "expected": "值 {v}"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": {"$native": "throwingToString"}}, "expected": "value {v}"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": {"$native": "throwingProxy"}}, "expected": "value {v}"},
    {"kind": "t", "ns": "web", "key": "代理 {v}", "lang": "zh", "varsNative": "throwingProxy", "expected": "代理 {v}"},

    {"kind": "t", "ns": "web", "key": "你好 {name}", "lang": "zh", "expected": "你好 {name}"},
    {"kind": "t", "ns": "web", "key": "你好 {name}", "lang": "en", "expected": "Hello {name}"},
    {"kind": "t", "ns": "web", "key": "你好 {name}", "lang": "zh", "vars": {"name": true}, "expected": "你好 true"},
    {"kind": "t", "ns": "web", "key": "你好 {name}", "lang": "en", "vars": {"name": 123}, "expected": "Hello 123"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": "1.0"}, "expected": "value 1.0"},
    {"kind": "t", "ns": "web", "key": "值 {v}", "lang": "en", "vars": {"v": ""}, "expected": "value "},

    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": 1.0}, "expected": "one:1"},
    {"kind": "t", "ns": "web", "key": "复数 {n}", "lang": "en", "vars": {"n": 1.9}, "expected": "other:1.9"},
