{
  "name": "@gavinc-cn/touchstone-dsh",
  "version": "0.1.1",
  "description": "AI-agent-driven automated testing platform for DeepSeek Harness (dsh): Markdown case library, bug reports, per-project serial queue, development board and built-in load testing.",
  "license": "MIT",
  "author": "Touchstone contributors",
  "type": "module",
  "main": "./dsh-plugin/lib/index.js",
  "exports": {
    ".": {
      "default": "./dsh-plugin/lib/index.js"
    },
    "./client": {
      "default": "./dsh-plugin/lib/client.bundle.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "*.py",
    "requirements.txt",
    "builtin_prompts",
    "extensions",
    "dsh-plugin/cordis.patch.yml",
    "dsh-plugin/install.sh",
    "dsh-plugin/lib",
    "dsh-plugin/scripts/build.mjs",
    "dsh-plugin/scripts/prepack-check.mjs",
    "dsh-plugin/scripts/select-bundle.mjs",
    "dsh-plugin/src",
    "webui/dist-plugin"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "build:client": "node dsh-plugin/scripts/build.mjs",
    "prepack": "node dsh-plugin/scripts/prepack-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavinc-cn/touchstone-dsh.git"
  },
  "homepage": "https://github.com/gavinc-cn/touchstone-dsh#readme",
  "bugs": {
    "url": "https://github.com/gavinc-cn/touchstone-dsh/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "touchstone",
    "testing",
    "automation",
    "agent"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
